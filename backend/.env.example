# Backend API Configuration
PORT=3000
MONGODB_URI=mongodb://localhost:27017/shiv-agri
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-dev-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
# Long-lived opaque refresh token lifetime (days) — applies to ALL login methods
# (Google + phone OTP). Stored hashed in DB, delivered as an httpOnly cookie.
REFRESH_TOKEN_TTL_DAYS=60

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

# ----- Media microservice -----
# Internal URL (container-to-container) — the backend uses this to call media-service.
# Local dev (services on host):       http://localhost:8081
# docker-compose (containers):        http://media-service:8081
MEDIA_SERVICE_URL=http://localhost:8081

# Public URL prepended to media download links returned to the client.
# Must be externally reachable — NOT a docker-internal hostname.
# Dev: http://localhost:80 (through nginx) or http://localhost:4200 (Angular proxy)
# Prod: https://shivagri.com
MEDIA_SERVICE_PUBLIC_URL=http://localhost:80

# ----- Feature flags -----
# Master switch for phone + WhatsApp OTP login.
#   true  — phone OTP login tab is shown; new Google users OTP-verify their phone.
#   false — "Google-only" mode: phone OTP login hidden, OTP endpoints disabled, and new
#           Google users enter their phone MANUALLY (no OTP) in the complete-profile step.
# Set to false while the WhatsApp Business number / template isn't production-ready.
OTP_LOGIN_ENABLED=true

# ----- Notification service (WhatsApp OTP delivery) -----
# Where the backend reaches the notification microservice.
# Local dev (notification-service running on host): http://localhost:8082
# docker-compose dev/prod (container-to-container):  http://notification-service:8082
NOTIFICATION_SERVICE_URL=http://localhost:8082

# MUST match the NOTIFICATION_API_KEY set on notification-service.
# Generate with: openssl rand -hex 32
NOTIFICATION_API_KEY=

# How the OTP is delivered:
#   template    — production. Uses an approved WhatsApp template (see vars below).
#   hello_world — dev workaround while waiting for template approval. Sends the
#                 universally-available `hello_world` template (no approval needed)
#                 AND prints the actual OTP code to backend stdout.
#                 Recipient must be on the WhatsApp Allowed Recipients list.
#   console     — pure dev. Prints the OTP to backend stdout, no provider call.
OTP_DELIVERY_MODE=template

# WhatsApp template wiring (used when OTP_DELIVERY_MODE=template).
# The template must be Approved in Meta Business Manager.
WHATSAPP_OTP_TEMPLATE_NAME=otp_login
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE_HAS_BUTTON=true

# Lab report delivery (WhatsApp + email)
# Approved Meta templates: DOCUMENT header (the PDF) + dynamic URL button https://shivagri.com/{{1}}
WHATSAPP_REPORT_TEMPLATE_SOIL=shiv_agri_soil_testing_report_ready
WHATSAPP_REPORT_TEMPLATE_WATER=shiv_agri_water_testing_report_ready
WHATSAPP_REPORT_TEMPLATE_FERTILIZER=shiv_agri_fertilizer_recommendation_report_ready
WHATSAPP_REPORT_TEMPLATE_LANGUAGE=en
PUBLIC_APP_URL=https://shivagri.com
REPORT_LINK_TTL_DAYS=90
REPORT_DELIVERY_MAX_ATTEMPTS=3
# REPORT_DELIVERY_RECONCILE_INTERVAL_MS=1800000
REPORT_EMAIL_BRAND_NAME=Shiv Agri Consultancy
REPORT_EMAIL_SUPPORT_PHONE=
REPORT_EMAIL_SUPPORT_EMAIL=

# App Links / Universal Links for https://shivagri.com/r/<token>
ANDROID_APP_PACKAGE=com.shivagri.app
# Comma-separated SHA-256 fingerprints of the release (and Play App Signing) certificates
ANDROID_APP_SHA256_CERT_FINGERPRINTS=
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.shivagri.app
IOS_STORE_URL=

# Phone OTP defaults
DEFAULT_PHONE_COUNTRY_CODE=+91
DEFAULT_PHONE_SIGNUP_ROLE=user
