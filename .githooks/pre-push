#!/bin/bash
# Auto-update context.md via Claude CLI before push
# Skip with: SKIP_CONTEXT_UPDATE=1 git push
# Or:        git push --no-verify

if [ "$SKIP_CONTEXT_UPDATE" = "1" ]; then
  echo "[pre-push] Skipping context.md update (SKIP_CONTEXT_UPDATE=1)"
  exit 0
fi

echo "[pre-push] Updating context.md with recent changes..."
claude -p "Review the git diff of staged/committed changes since the last push. Update ONLY the affected sections in context.md to reflect these changes. Keep updates surgical — don't rewrite unrelated sections." --allowedTools Edit,Read,Grep,Glob,Bash

if [ $? -eq 0 ]; then
  echo "[pre-push] context.md updated successfully"
else
  echo "[pre-push] context.md update failed — push will continue anyway"
fi

exit 0
