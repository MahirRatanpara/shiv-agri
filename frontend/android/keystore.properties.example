# Copy this file to `keystore.properties` (same folder) and fill in your values.
# `keystore.properties` is git-ignored and must NEVER be committed.
#
# Create the keystore once with:
#   keytool -genkey -v -keystore shiv-agri-release.jks \
#     -keyalias shiv-agri -keyalg RSA -keysize 2048 -validity 10000
#
# Keep shiv-agri-release.jks and these passwords backed up somewhere safe —
# losing them means you can never update the app on the Play Store again.

storeFile=shiv-agri-release.jks
storePassword=CHANGE_ME
keyAlias=shiv-agri
keyPassword=CHANGE_ME
