#!/bin/sh
# Maven Wrapper script
# Adapted from https://github.com/apache/maven-wrapper

set -e

# Determine the project base directory
if [ -z "$MAVEN_PROJECTBASEDIR" ]; then
  MAVEN_PROJECTBASEDIR=$(cd "$(dirname "$0")" && pwd)
  export MAVEN_PROJECTBASEDIR
fi

WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Read distribution URL from properties
if [ -r "$WRAPPER_PROPERTIES" ]; then
  MAVEN_DIST_URL=$(grep -E '^distributionUrl=' "$WRAPPER_PROPERTIES" | cut -d'=' -f2-)
fi

if [ -z "$MAVEN_DIST_URL" ]; then
  MAVEN_DIST_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.6/apache-maven-3.9.6-bin.zip"
fi

# Maven installation directory
MAVEN_HOME_DIR="${HOME}/.m2/wrapper/dists/apache-maven-3.9.6"

if [ ! -d "$MAVEN_HOME_DIR" ]; then
  echo "Downloading Maven from $MAVEN_DIST_URL"
  mkdir -p "$MAVEN_HOME_DIR"
  TMPFILE=$(mktemp /tmp/maven-XXXXXX.zip)

  if command -v curl > /dev/null 2>&1; then
    curl -fsSL "$MAVEN_DIST_URL" -o "$TMPFILE"
  elif command -v wget > /dev/null 2>&1; then
    wget -q "$MAVEN_DIST_URL" -O "$TMPFILE"
  else
    echo "Error: Neither curl nor wget found. Cannot download Maven." >&2
    exit 1
  fi

  unzip -q "$TMPFILE" -d "$MAVEN_HOME_DIR"
  rm -f "$TMPFILE"
fi

# Find the maven executable
MVN_CMD=$(find "$MAVEN_HOME_DIR" -name "mvn" -path "*/bin/mvn" -type f | head -1)

if [ -z "$MVN_CMD" ]; then
  echo "Error: Could not find mvn executable in $MAVEN_HOME_DIR" >&2
  exit 1
fi

chmod +x "$MVN_CMD"
exec "$MVN_CMD" "$@"
